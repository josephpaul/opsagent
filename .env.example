# Copy to .env and fill in your keys. The app loads .env from the current directory
# (or from the path in OPSAGENT_ENV). Use --provider gemini|openai|anthropic.

# Gemini (default). Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# OpenAI (optional). Get one at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional). Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key_here
