# Choose one provider: gemini | anthropic | openai (default: gemini)
AI_PROVIDER=gemini
# Optional: model override (e.g. gpt-4o, claude-3-5-sonnet-20241022, gemini-2.5-flash)
# AI_MODEL=gemini-2.5-flash

# --- API keys (set the one for your chosen provider) ---
# Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: server agent URL (default: http://localhost:8080)
# SERVER_AGENT_URL=http://localhost:8080
